# Salin ke .env.local lalu sesuaikan.

# Base URL API yang dipanggil browser.
# - "/api/v1"  → lewat proxy Next.js (next.config.ts), tidak butuh CORS di backend
# - "http://localhost:8000/api/v1" → langsung ke FastAPI (backend harus memasang CORS untuk origin frontend)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Alamat FastAPI untuk proxy di atas (dibaca server Next.js, bukan browser).
# `next dev` membacanya saat start; untuk `next build` nilainya dibekukan saat build.
BACKEND_URL=http://localhost:8000
